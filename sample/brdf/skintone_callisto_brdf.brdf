analytic

# DERIVED from callisto_brdf.brdf - skin tone base colour variant.
# Generated by scripts/gen_skintone_callisto.py; do not edit by hand.
# CUSTOM IMPLEMENTATION (独自実装). The lighting is identical to callisto_brdf.brdf;
# only the albedo differs: it is built from a 110-column skin tone chart (embedded
# as SKIN_CHART, selected by "skintone"), the LDR mask offset (ldr_mask - 0.5, added
# in gamma space, then pow 2.2) and blended with base_color by hair_mask.
# On the Lit Object mesh dm.obj, base_color, ldr_mask and hair_mask get default
# textures (assets/obj/textures.json). Elsewhere the slider values are used.
# Parameters below base_color follow callisto_brdf.brdf, except roughness1_scale 1.1.
#
# CUSTOM IMPLEMENTATION (独自実装) / APPROXIMATION.
# Callisto-style BRDF - project-specific reconstruction of the "Callisto BRDF"
# (The Callisto Protocol, SIGGRAPH 2023 Advances, Jimenez & Petersen).
# Reconstructed from the game's shipped SubsurfaceProfile values and a GPU capture
# of its deferred lighting shader (UE4.27 licensee branch). This is not the
# original implementation. It matches the reconstructed shipped formula numerically
# (scripts/verify_callisto_brdf.py) but has not been compared with game screenshots.
#
# Included: Lambert diffuse with Diffuse Fresnel, Anti-Specular Peak and Diffuse
# Smooth Terminator; UE-style dual-lobe GGX (Roughness0/1 scale, LobeMix) with a
# tinted second lobe F0, Specular Fresnel Falloff and per-channel Specular Smooth
# Terminator. "advanced_strength" = 0 gives the plain UE4 SubsurfaceProfile BRDF.
#
# Not included (renderer side): transmission, the
# SubsurfaceProfile texture and GBuffer packing, Dual Normal (a single N is used
# for diffuse and specular), Specular Glazing Blur (screen-space stochastic
# neighbour normal/shadow), area-light GGX normalization, shadows, Realis.
# Returns the BRDF value without the NoL factor, like the other samples.
#
# Specular Glazing Blur is not part of BRDF() either. The viewer's
# Lit Object has a "Glazing" checkbox (on by default; a custom approximation, see
# docs/glazing_blur.md) that applies it with IBL and Occlusion = Ray, using the
# glazing_blur_radius parameter and the BRDF_sss_diffuse / BRDF_sss_albedo hooks.
#
# Subsurface scattering is not part of BRDF(). The viewer's pseudo SSS (Lit Object,
# "SSS" checkbox, on by default; a custom screen-space approximation, see
# docs/pseudo_sss.md) uses the two hook functions BRDF_sss_diffuse / BRDF_sss_albedo
# below and the sss_* parameters (profile ScatterRadius, FalloffColor, SubsurfaceColor).
# The plots, Image Slice, Lit Sphere and evaluate() never include it.
#
# Defaults: Jacob head profile (SP_Jacob_Head). Other shipped profiles:
#   generic skin (SSP_HumanSkin): r0 0.44, lobe_mix 0.95, dual tint (0.464,1,0.91),
#     fresnel_falloff 0.55, anti peak (0,1,0.5), SST 0.3 tint (1,1,1), DST 0.15
#   eye (*_Eye_Main): r0 1.1, r1 2.0, lobe_mix 0.175, dual tint (1,1.4,0.8),
#     diffuse_fresnel_peak 6, others default
#   teeth (*_Teeth): r0 0.75 (UE default), r1 2.0, lobe_mix 0.7, anti peak (1.5,1.5,1.1) falloff 4,
#     diffuse_fresnel_peak 4
#   prisoner cloth (SP_Player_Jacob_Cloth): r0 1, r1 1, lobe_mix 1,
#     dual tint (1,0.8,0.1), fresnel_falloff 0.75, SST 0.5 tint (0,0.5,1),
#     DST 0.5, anti peak (0.5,0.5,0.5) falloff 0.5, diffuse_fresnel_peak 5
# Pseudo SSS values (scatter radius cm, falloff rgb, subsurface rgb):
#   generic skin 0.6, (1,0.25,0.05), (1,1,1); eye 0.5, (1,0.65,0.15), (1,1,1);
#   teeth 1.5, (0.8,0.5,0.25), (1,1,1); prisoner cloth 10, (1,0.35,0), (0.1,0.1,0.1)
# Glazing blur radius (cm): head 0.25, generic skin 0.15; eye, teeth, prisoner cloth 0 (off)
# Neutral values: tints 1, peaks 1, falloffs 1, terminators 0.
# base_color is sRGB (exact sRGB curve in mon2lin); the *_r/_g/_b tints are linear multipliers
# taken directly from the game data.

::begin parameters
color base_color 0.72 0.53 0.45  # 髪の部分の色（sRGB）。hair_mask が 1 の所で使う。Lit Object の dm.obj では T_emily_BC が既定で付く / colour of the hair area (sRGB), used where hair_mask is 1; T_emily_BC by default on the Lit Object dm.obj
float skintone 1.0 110.0 72.0  # 肌トーンの番号（チャートの列 1〜110、小数は切り捨て）。hair_mask が 0 の所の色を決める / skin tone number (chart column 1-110, fraction dropped); sets the colour where hair_mask is 0
color ldr_mask 0.5 0.5 0.5  # 肌の明暗の差分。0.5 が基準で、チャートの色に (値−0.5) を足す。テクスチャは値をそのまま使う（sRGB 扱い、デコードなし）。dm.obj では Test_face_system_LDR_MASK が既定で付く / skin shading offset: (value - 0.5) is added to the chart colour, 0.5 = none; a texture is used as is (sRGB, not decoded); Test_face_system_LDR_MASK by default on dm.obj
float hair_mask 0.0 1.0 0.0  # 髪マスク（R）。0 で肌トーン、1 で base_color / hair mask (R): 0 = skin tone, 1 = base_color; Test_face_system_HairMask by default on dm.obj
float specular 0.0 1.0 0.5  # UE の Specular（F0 = 0.08×値） / UE Specular (F0 = 0.08 x value)
float roughness 0.02 1.0 0.5  # ラフネス（下限 0.02） / roughness (clamped to >= 0.02)
float advanced_strength 0.0 1.0 1.0  # Callisto 項の効き m。0 で標準 UE4 SSP と同じ / strength m of the Callisto terms; 0 = plain UE4 SubsurfaceProfile
float roughness0_scale 0.0 2.0 0.55  # 第1ローブのラフネス倍率（SSP Roughness0） / lobe 0 roughness scale (SSP Roughness0)
float roughness1_scale 0.0 2.0 1.1  # 第2ローブのラフネス倍率（SSP Roughness1） / lobe 1 roughness scale (SSP Roughness1)
float lobe_mix 0.0 1.0 0.9  # 2つのローブの混合量（SSP LobeMix） / blend between the two lobes (SSP LobeMix)
float dual_spec_tint_r 0.0 4.0 1.1  # 第2ローブの F0 ティント R（DualSpecularTint） / second lobe F0 tint R (DualSpecularTint)
float dual_spec_tint_g 0.0 4.0 0.95  # 第2ローブの F0 ティント G / second lobe F0 tint G
float dual_spec_tint_b 0.0 4.0 1.0  # 第2ローブの F0 ティント B / second lobe F0 tint B
float spec_fresnel_falloff 0.0 2.0 0.65  # フレネル指数の倍率（5×値）。小さいほど縁が早く明るい / Fresnel exponent scale (5 x value); lower = earlier grazing rise
float spec_smooth_terminator 0.0 1.0 0.3  # スペキュラの明暗境界の幅（N·L） / specular terminator width in N.L
float spec_term_tint_r 0.0 1.0 1.0  # スペキュラ境界幅のティント R（SpecularSmoothTerminatorTint） / specular terminator tint R
float spec_term_tint_g 0.0 1.0 0.7  # スペキュラ境界幅のティント G。小さいと境界に赤が残る / specular terminator tint G; lower keeps red at the edge
float spec_term_tint_b 0.0 1.0 0.85  # スペキュラ境界幅のティント B / specular terminator tint B
float diffuse_smooth_terminator 0.0 1.0 0.15  # 拡散の明暗境界の幅（N·L） / diffuse terminator width in N.L
float diffuse_fresnel_peak 0.0 9.0 1.0  # 拡散フレネルの強さ。L·H→0（逆光・縁）で拡散を何倍にするか / Diffuse Fresnel peak: diffuse multiplier as L.H->0 (backlit rim)
float anti_spec_peak_r 0.0 9.0 0.5  # 輪郭（N·H→0）で拡散に掛ける色 R（DiffuseAntiSpecularPeak） / diffuse tint R near N.H->0 (DiffuseAntiSpecularPeak)
float anti_spec_peak_g 0.0 9.0 1.0  # 輪郭で拡散に掛ける色 G / diffuse tint G near N.H->0
float anti_spec_peak_b 0.0 9.0 0.0  # 輪郭で拡散に掛ける色 B / diffuse tint B near N.H->0
float anti_spec_peak_falloff 0.01 9.0 0.125  # AntiSpecularPeak の範囲。小さいほど輪郭だけに効く / AntiSpecularPeak falloff; lower = only at the silhouette
float glazing_blur_radius 0.0 3.0 0.25  # Glazing Blur（独自実装・近似。Lit Object の Glazing がオン、IBL かつ Occlusion が Ray のとき）: 明暗境界でスペキュラ用の法線と影を借りる近くの画素までの最大距離 cm（SSP SpecularGlazingBlurRadius）。0 で無効。顔は 0.25。大きくすると効果を確認しやすい / Glazing Blur (custom approximation; Lit Object, Glazing on, IBL with Occlusion = Ray): largest distance in cm to the nearby pixel whose specular normal and shadow are borrowed near the light/dark boundary (SSP SpecularGlazingBlurRadius); 0 = off, head 0.25; raise it to make the effect easier to see
float glazing_graze_power 0.0 8.0 4.0  # Glazing Blur（確認用）: 距離に掛ける (1−N·L) の指数。元の動作は 4（光がかすめる所だけ）。0 にすると光の方を向いた面でも同じ距離で借りる（落ち影の境界もぼける） / Glazing Blur (tuning): exponent of the (1 - N.L) weight on the distance; reconstructed behaviour 4 (grazing light only); 0 borrows at the full distance on light-facing surfaces too (cast-shadow edges blur as well)
float glazing_radius_power 0.5 6.0 3.0  # Glazing Blur（確認用）: 借りる画素の散らし方。距離の割合 = 乱数^指数。元の動作は 3（近くに集まる）。1 で半径方向に一様、0.5 で円内に一様 / Glazing Blur (tuning): spread of the borrowed pixels, distance fraction = random^power; reconstructed behaviour 3 (dense near the pixel), 1 = uniform in radius, 0.5 = uniform over the disc
float glazing_depth_tolerance 0.0 5.0 0.5  # Glazing Blur（確認用）: 借りる画素との奥行きの差の上限 cm。元の動作は 0.5。大きくすると段差をまたいで借りる / Glazing Blur (tuning): largest view-depth difference in cm to a borrowed pixel; reconstructed behaviour 0.5; higher borrows across depth steps
float sss_strength 0.0 1.0 1.0  # 疑似SSS（Lit Object の SSS がオンのとき）: 散乱の強さ。散乱の距離に掛かる。ゲームでは画素ごとの m×Opacity に当たるが、ここでは advanced_strength（m）と独立 / pseudo SSS (Lit Object, SSS on): scatter strength, multiplies the scatter radius. The game uses m x Opacity per pixel; here it is independent of advanced_strength (m)
float sss_scatter_radius 0.0 20.0 0.5  # 疑似SSS: 散乱が届く距離 cm（SSP ScatterRadius）。Lit Object の Size (cm) で画面上の大きさが決まる / pseudo SSS: scatter reach in cm (SSP ScatterRadius); Lit Object "Size (cm)" sets its size on screen
float sss_falloff_r 0.0 1.0 1.0  # 疑似SSS: 赤の広がり（SSP FalloffColor R）。小さいほど狭い / pseudo SSS: red spread (SSP FalloffColor R); lower = narrower
float sss_falloff_g 0.0 1.0 0.25  # 疑似SSS: 緑の広がり（SSP FalloffColor G） / pseudo SSS: green spread (SSP FalloffColor G)
float sss_falloff_b 0.0 1.0 0.05  # 疑似SSS: 青の広がり（SSP FalloffColor B） / pseudo SSS: blue spread (SSP FalloffColor B)
float sss_subsurface_r 0.0 1.0 1.0  # 疑似SSS: 散乱した拡散光を混ぜる割合 R（SSP SubsurfaceColor）。0 で散乱なし / pseudo SSS: share of scattered diffuse light, R (SSP SubsurfaceColor); 0 = no scattering
float sss_subsurface_g 0.0 1.0 1.0  # 疑似SSS: 散乱した拡散光を混ぜる割合 G / pseudo SSS: share of scattered diffuse light, G
float sss_subsurface_b 0.0 1.0 1.0  # 疑似SSS: 散乱した拡散光を混ぜる割合 B / pseudo SSS: share of scattered diffuse light, B
bool glazing_borrow_normal 1  # Glazing Blur（確認用）: スペキュラ用の法線を近くの画素から借りる。元の動作はオン / Glazing Blur (tuning): borrow the specular normal from the nearby pixel; reconstructed behaviour on
bool glazing_borrow_shadow 1  # Glazing Blur（確認用）: 影（レイの出発点）を近くの画素から借りる。拡散とスペキュラの両方に効く。元の動作はオン / Glazing Blur (tuning): borrow the shadow (ray origin) from the nearby pixel, for diffuse and specular alike; reconstructed behaviour on
::end parameters

::begin shader

const float PI = 3.14159265358979323846;
const float EPS = 0.000001;

float sqr(float x) { return x * x; }
float pow4(float x) { float x2 = x * x; return x2 * x2; }
float saturate(float x) { return clamp(x, 0.0, 1.0); }
vec3 saturate(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }

vec3 mon2lin(vec3 x) {
    // Exact sRGB EOTF (IEC 61966-2-1), matching the color picker's Linear values.
    vec3 c = clamp(x, vec3(0.0), vec3(1.0));
    vec3 lo = c / 12.92;
    vec3 hi = pow((c + vec3(0.055)) / 1.055, vec3(2.4));
    return mix(hi, lo, vec3(lessThanEqual(c, vec3(0.04045))));
}

// smoothstep(0, 1, saturate(x / w)); a zero width disables the terminator.
float smoothTerminator(float x, float w) {
    if (w <= 0.0) return 1.0;
    float t = saturate(x / w);
    return t * t * (3.0 - 2.0 * t);
}

float dGGX(float a2, float NoH) {
    float d = (NoH * a2 - NoH) * NoH + 1.0;
    return a2 / (PI * d * d);
}

float visSmithJointApprox(float a2, float NoV, float NoL) {
    float a = sqrt(a2);
    float visV = NoL * (NoV * (1.0 - a) + a);
    float visL = NoV * (NoL * (1.0 - a) + a);
    return 0.5 / max(visV + visL, EPS);
}

// UE F_Schlick with a variable exponent (5 * Specular Fresnel Falloff).
vec3 fresnelFalloff(vec3 F0, float VoH, float exponent) {
    float Fc = pow(1.0 - VoH, exponent);
    return F0 + (vec3(saturate(50.0 * F0[1])) - F0) * Fc;
}

// Diffuse term without the albedo: Lambert 1/PI times the three Callisto diffuse
// factors (blended from neutral by advanced_strength).
vec3 callistoDiffuse(vec3 L, vec3 V, vec3 N) {
    float NoLRaw = dot(N, L);
    if (NoLRaw <= 0.0 || dot(N, V) <= 0.0) return vec3(0.0);

    float m = saturate(advanced_strength);
    vec3 H = normalize(L + V);
    float NoL = saturate(NoLRaw);
    float NoH = saturate(dot(N, H));
    float LoH = saturate(dot(L, H));

    vec3 antiPeak = mix(vec3(1.0), vec3(anti_spec_peak_r, anti_spec_peak_g, anti_spec_peak_b), m);
    float antiFall = max(mix(1.0, anti_spec_peak_falloff, m), 0.00001);
    float diffFres = mix(1.0, diffuse_fresnel_peak, m);
    float diffTerm = m * diffuse_smooth_terminator;

    vec3 diffuse = vec3(1.0 / PI);
    diffuse *= mix(diffFres, 1.0, sqrt(LoH));                         // Diffuse Fresnel
    diffuse *= mix(antiPeak, vec3(1.0), pow(NoH, antiFall));          // Anti-Specular Peak
    diffuse *= smoothTerminator(NoL, diffTerm);                       // Diffuse Smooth Terminator
    return diffuse;
}

// ---- pseudo SSS hooks (brdf_view extension, optional; docs/pseudo_sss.md) ----
// Lit Object with "SSS" on blurs BRDF_sss_diffuse (lit, before albedo) in screen
// space, multiplies it by BRDF_sss_albedo and adds the rest of BRDF() unblurred.
// Contract: BRDF() == BRDF_sss_diffuse() * BRDF_sss_albedo() + specular.
// ---- skin tone base colour (this file only) ----
// Chart column samples (u = (i - 0.5) / 110, v = 0.5), not decoded: the chart is read as
// gamma-space values. Generated by scripts/gen_skintone_callisto.py.
