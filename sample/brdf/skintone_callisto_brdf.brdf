    vec3(0.862745, 0.662745, 0.576471),
    vec3(0.854902, 0.666667, 0.576471)
);

// Linear albedo: skin tone from the chart plus the LDR mask offset, raised to 2.2
// (not the exact sRGB curve), blended with the decoded base_color by hair_mask.
vec3 skinToneAlbedo() {
    int column = int(clamp(floor(skintone + 0.1), 1.0, 110.0) - 1.0);
    vec3 skin = saturate((ldr_mask - vec3(0.5)) + SKIN_CHART[column]);
    skin = pow(max(skin, vec3(0.0)), vec3(2.2));
    return mix(skin, mon2lin(base_color), saturate(hair_mask));
}

vec3 BRDF_sss_albedo() {
    return saturate(skinToneAlbedo());
}

vec3 BRDF_sss_diffuse(vec3 L, vec3 V, vec3 N, vec3 X, vec3 Y) {
    return callistoDiffuse(L, V, N);
}

vec3 BRDF(vec3 L, vec3 V, vec3 N, vec3 X, vec3 Y) {
    float NoLRaw = dot(N, L);
    float NoVRaw = dot(N, V);
    if (NoLRaw <= 0.0 || NoVRaw <= 0.0) return vec3(0.0);

    float m = saturate(advanced_strength);
    vec3 H = normalize(L + V);
    float NoL = saturate(NoLRaw);
    float NoV = saturate(abs(NoVRaw) + 0.00001);
    float NoH = saturate(dot(N, H));
    float VoH = saturate(dot(V, H));

    vec3 F0 = vec3(0.08 * saturate(specular));

    // Callisto parameters, blended from neutral by advanced_strength.
    vec3 dualTint = mix(vec3(1.0), vec3(dual_spec_tint_r, dual_spec_tint_g, dual_spec_tint_b), m);
    vec3 specTermW = m * spec_smooth_terminator * vec3(spec_term_tint_r, spec_term_tint_g, spec_term_tint_b);
    float fresFall = mix(1.0, spec_fresnel_falloff, m);

    // ---- diffuse ----
    vec3 diffuse = BRDF_sss_albedo() * callistoDiffuse(L, V, N);

    // ---- specular: dual-lobe GGX ----
    // Lobe roughness as shipped: the BasePass writes saturate(R * lerp(1, avg, m)) to the
    // GBuffer (avg = lerp(Roughness0, Roughness1, LobeMix)); the light scales it back by
    // Roughness0/avg (Roughness1/avg), floors at 0.02 and fades by m. With m = 1 this is
    // roughness * RoughnessN (while roughness * avg <= 1); with m = 0 it is roughness.
    float avg = max(mix(roughness0_scale, roughness1_scale, lobe_mix), 0.00001);
    float roughG = saturate(roughness * mix(1.0, avg, m));
    float r0 = mix(max(roughG, 0.02), max(saturate(roughness0_scale / avg * roughG), 0.02), m);
    float r1 = mix(max(roughG, 0.02), max(saturate(roughness1_scale / avg * roughG), 0.02), m);
    float exponent = 5.0 * max(fresFall, 0.00001);
    vec3 F_0 = fresnelFalloff(F0, VoH, exponent);
    vec3 F_1 = fresnelFalloff(F0 * dualTint, VoH, exponent);         // tinted second lobe
    float a2_0 = pow4(r0);
    float a2_1 = pow4(r1);
    vec3 lobe0 = dGGX(a2_0, NoH) * visSmithJointApprox(a2_0, NoV, NoL) * F_0;
    vec3 lobe1 = dGGX(a2_1, NoH) * visSmithJointApprox(a2_1, NoV, NoL) * F_1;
    vec3 spec = mix(lobe0, lobe1, lobe_mix);

    // per-channel Specular Smooth Terminator; the tint fades toward grazing view
    vec3 w = mix(vec3(dot(specTermW, vec3(1.0 / 3.0))), specTermW, min(NoV, 1.0));
    spec *= vec3(smoothTerminator(NoL, w[0]),
                 smoothTerminator(NoL, w[1]),
                 smoothTerminator(NoL, w[2]));

    return diffuse + spec;
}

::end shader
