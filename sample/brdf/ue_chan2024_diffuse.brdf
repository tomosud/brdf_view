analytic

# Unreal Engine BRDF.ush Diffuse_GGX_Rough, ROUGH_DIFFUSE_BRDF_VERSION == 2.
# Chan 2024 branch from the source comment:
# "Multiscattering Diffuse and Specular BRDFs", unpublished manuscript.

::begin parameters
color diffuse_color 1.0 1.0 1.0
float roughness 0.0 1.0 0.5
float retro_reflectivity_weight 0.0 1.0 1.0
::end parameters

::begin shader

const float PI = 3.14159265358979323846;

float saturate(float x) { return clamp(x, 0.0, 1.0); }
vec3 saturate(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }

vec3 mon2lin(vec3 x) {
    // Exact sRGB EOTF (IEC 61966-2-1), matching the color picker's Linear values.
    vec3 c = clamp(x, vec3(0.0), vec3(1.0));
    vec3 lo = c / 12.92;
    vec3 hi = pow((c + vec3(0.055)) / 1.055, vec3(2.4));
    return mix(hi, lo, vec3(lessThanEqual(c, vec3(0.04045))));
}

vec3 diffuseChan2024(vec3 diffuseColor, float rough, float NoH, float VoH)
{
    float alpha = rough * rough;
    const float fSmooth = 1.0;
    float scale = max(0.55 - 0.2 * rough, 1.25 - 1.6 * rough);
    float bias = saturate(4.0 * alpha);
    float fRough = scale * (NoH + bias) / max(NoH + 0.025, 0.000001) * VoH * VoH;
    float diffuseSS = mix(fSmooth, fRough, rough);
    float diffuseMS = alpha * 0.38;
    return diffuseColor * ((diffuseSS + diffuseMS) * (1.0 / PI));
}

vec3 BRDF(vec3 L, vec3 V, vec3 N, vec3 X, vec3 Y)
{
    float NoL = saturate(dot(N, L));
    float NoV = saturate(dot(N, V));
    if (NoL <= 0.0 || NoV <= 0.0) return vec3(0.0);

    vec3 H = normalize(L + V);
    float NoH = saturate(dot(N, H));
    float VoH = saturate(dot(V, H));
    float r = saturate(roughness) * saturate(retro_reflectivity_weight);
    return diffuseChan2024(saturate(mon2lin(diffuse_color)), r, NoH, VoH);
}

::end shader
